        except:
            print("⚠️ Google timeout")
            return
        
        # Handle Google CAPTCHA
        if "google.com/sorry" in self.current_browser.driver.current_url:
            print("🚨 GOOGLE CAPTCHA - Please solve manually")
            input(">>> Press ENTER after solving <<<")
            try:
                self.current_browser.driver.refresh()
                time.sleep(2)
            except:
                pass
        
        # Process pages
        for page_num in range(1, PAGES_TO_SCAN + 1):
            print(f"\n📄 Page {page_num}")
            
            results = self.extract_google_results()
            print(f"  📌 Found {len(results)} URLs")
            
            if results:
                for url in results:
                    self.process_site(url, keyword)
                    
                    # Switch back to search tab after processing
                    self.current_browser.switch_to_search_tab()
                    
                    stats = get_stats()
                    print(f"  ⏱️ {stats['elapsed']} | 📋 {len(self.all_pending_tabs)} filled | 📊 {stats['rate']}")
                    time.sleep(0.5)
            
            # Next page
            if page_num < PAGES_TO_SCAN:
                try:
                    next_url = f"{search_url}&start={page_num * 10}"
                    self.current_browser.switch_to_search_tab()
                    self.current_browser.driver.get(next_url)
                    time.sleep(1)
                except:
                    break
        
        # Check if we should pause after reaching 4 browsers (100 tabs)
        if total_browsers >= 4:
            print(f"\n{'='*60}")
            print(f"⏸️ PAUSED - {total_browsers} browsers ready for review")
            print(f"📋 {len(self.all_pending_tabs)} tabs filled and waiting")
            print(f"{'='*60}")
            
            for browser in self.browsers:
                print(f"  🪟 Browser #{browser.browser_id}: {len(browser.pending_tabs)} tabs")
            
            msg = (
                f"⏸️ BOT PAUSED\n"
                f"🪟 {total_browsers} browsers ready for review\n"
                f"📋 {len(self.all_pending_tabs)} tabs filled\n"
                f"⏰ Time for manual review!\n"
                f"🔍 Keyword: {keyword}"
            )
            send_text_telegram(msg)
            
            print("\n🛑 PAUSED FOR REVIEW - 4 browsers (~100 tabs)")
            input(">>> Press ENTER when ready to continue (or Ctrl+C to stop)...")

    def run(self):
        """Main bot loop"""
        print("\n" + "="*60)
        print("🚀 FORM ASSISTANT - MANUAL REVIEW MODE")
        print("="*60)
        print("⚡ FEATURES:")
        print("  • Fills forms but DOESN'T submit")
        print("  • Keeps ALL browsers and tabs open")
        print("  • Creates new browsers when needed (25 tabs each)")
        print("  • Detects message fields by labels AND attributes")
        print("  • 50+ message field variations detected")
        print("  • Shows MX records for each domain")
        print("  • Respects blacklist (no duplicates)")
        print("  • Pauses after 4 browsers (~100 tabs)")
        print("  • Silent operation (no Chrome warnings)")
        print("="*60)
        
        self.initialize()
        
        cycle = 0
        while True:
            cycle += 1
            print(f"\n{'='*60}")
            print(f"🔄 CYCLE {cycle}")
            print(f"{'='*60}")
            
            for keyword in self.keywords:
                self.scan_keyword(keyword)
            
            stats = get_stats()
            msg = (
                f"🎊 <b>CYCLE {cycle} COMPLETE</b>\n"
                f"⏱️ {stats['elapsed']}\n"
                f"📝 {len(self.all_pending_tabs)} tabs ready for review\n"
                f"🌐 {stats['domains_visited']} domains visited\n"
                f"🪟 {stats['browsers']} browsers created"
            )
            send_text_telegram(msg)
            print(f"\n{msg}\n")
            
            print("⏳ Waiting 30s before next cycle...")
            time.sleep(30)

