    def get_label_text(self, driver, element):
        """Get label text for a form field by checking multiple methods"""
        label_text = ""
        try:
            # Method 1: Check for associated label using 'for' attribute
            elem_id = element.get_attribute('id')
            if elem_id:
                try:
                    labels = driver.find_elements(By.CSS_SELECTOR, f'label[for="{elem_id}"]')
                    if labels:
                        label_text += " " + labels[0].text
                except:
                    pass
            
            # Method 2: Check if element is wrapped in a label
            try:
                parent = element.find_element(By.XPATH, '..')
                if parent.tag_name.lower() == 'label':
                    label_text += " " + parent.text
            except:
                pass
            
            # Method 3: Check for nearby label (previous sibling or parent's previous sibling)
            try:
                prev_sibling = driver.execute_script("""
                    var elem = arguments[0];
                    var prev = elem.previousElementSibling;
                    if (prev && prev.tagName.toLowerCase() === 'label') {
                        return prev.textContent;
                    }
                    // Check parent's previous sibling
                    var parent = elem.parentElement;
                    if (parent) {
                        prev = parent.previousElementSibling;
                        if (prev && prev.tagName.toLowerCase() === 'label') {
                            return prev.textContent;
                        }
                    }
                    return '';
                """, element)
                if prev_sibling:
                    label_text += " " + prev_sibling
            except:
                pass
            
            # Method 4: Check for aria-label
            aria_label = element.get_attribute('aria-label')
            if aria_label:
                label_text += " " + aria_label
                
        except:
            pass
        
        return label_text.lower().strip()

